# Everything below is OPTIONAL: with no keys at all the lab runs fully offline on
# deterministic mock providers (same code paths, no network).

# Real LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional tracing providers
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional search provider
TAVILY_API_KEY=

# Provider / engine selection: auto | openai | mock, auto | tavily | mock,
# auto | langgraph | sequential
LLM_PROVIDER=auto
SEARCH_PROVIDER=auto
ENGINE=auto

# Runtime config
APP_ENV=local
LOG_LEVEL=INFO

# Guardrails
MAX_ITERATIONS=8
TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=3
MAX_REVISIONS=1
MAX_COST_USD=1.0
ENABLE_CRITIC=true
